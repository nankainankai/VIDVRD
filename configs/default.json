{
  "video_ingest": {
    "download_timeout_sec": 120,
    "overwrite_download": false
  },
  "models": {
    "vl": {
      "provider": "dashscope",
      "model": "qwen-vl-max",
      "api_key_env": "DASHSCOPE_API_KEY",
      "retries": 2,
      "backoff_sec": 1.5,
      "sleep_sec": 0.0,
      "dry_run": false
    },
    "strong_vl": {
      "provider": "dashscope",
      "model": "qwen-vl-max",
      "api_key_env": "DASHSCOPE_API_KEY",
      "retries": 2,
      "backoff_sec": 2.0,
      "sleep_sec": 0.0,
      "dry_run": false
    }
  },
  "audio_prior": {
    "enabled": true,
    "csv_path": "data/vggsound/vggsound.csv",
    "video_id_column": "video_id",
    "label_column": "label",
    "confidence_column": "",
    "fallback_label": "",
    "fallback_confidence": 0.5
  },
  "detector": {
    "backend": "rexomni",
    "dinox_api_token_env": "DINOX_API_TOKEN",
    "dinox_text_prompt": "person",
    "dinox_model": "DINO-X-1.0",
    "dinox_bbox_threshold": 0.25,
    "dinox_iou_threshold": 0.8,
    "dinox_nms_iou_threshold": 0.55,
    "dinox_min_box_area": 500.0,
    "dinox_max_detections_per_frame": 60,
    "dinox_image_max_long_edge": 640,
    "dinox_detection_interval": 5,
    "dinox_max_calls": 50,
    "dinox_request_retries": 1,
    "dinox_request_backoff_sec": 1.2,
    "rex_model_path": "D:/Rex-Omni-AWQ",
    "rex_backend": "transformers",
    "rex_categories": "person",
    "rex_detection_interval": 1,
    "rex_min_box_area": 500.0,
    "rex_max_detections_per_frame": 60,
    "rex_max_tokens": 512,
    "keyframe_interval": 25,
    "interp_iou_thresh": 0.1,
    "save_box_video": false,
    "auto_install_rexomni": false,
    "auto_install_torch": "skip"
  },
  "tracking": {
    "window_size": 30,
    "stride": 15,
    "iou_threshold": 0.5,
    "max_age": 30,
    "min_hits": 3,
    "class_aware": true,
    "max_center_dist_ratio": 0.8,
    "min_new_track_conf": 0.35,
    "velocity_alpha": 0.8,
    "enable_llm_qc": true,
    "llm_qc_model": "qwen-vl-max",
    "qc_sample_frames": 8,
    "qc_count_diff_threshold": 1,
    "export_pair_viz_videos": true,
    "pair_viz_max_windows": 0,
    "pair_viz_max_pairs_per_window": 6
  },
  "keyframe_screen": {
    "enabled": true,
    "sample_frames": 8,
    "max_frame_index": 240,
    "min_objects": 2,
    "min_confidence": 0.0,
    "required_positive_frames": 1,
    "vl_enabled": false,
    "vl_dry_run": false,
    "vl_model": "qwen-vl-max",
    "vl_tile_h": 320,
    "vl_retries": 2,
    "vl_backoff_sec": 1.5
  },
  "track_qc": {
    "min_track_frames": 2,
    "max_class_changes": 1,
    "max_center_jump_ratio": 0.45,
    "vl_enabled": false,
    "vl_dry_run": false,
    "vl_model": "qwen-vl-max",
    "vl_max_frames": 6,
    "vl_tile_h": 320
  },
  "relation_rule": {
    "enabled": true,
    "min_vote_ratio": 0.6,
    "axis_margin_ratio": 0.08,
    "near_distance_ratio": 0.35,
    "overlap_iou_threshold": 0.05,
    "max_pairs_per_window": 0
  },
  "relations": {
    "api_model": "qwen-vl-max",
    "relations": "",
    "group_size": 3,
    "max_windows": 0,
    "max_frames_per_window": 8,
    "vggsound_label": "",
    "retries": 2,
    "backoff_sec": 1.5,
    "sleep_sec": 0.0,
    "dry_run": false
  },
  "relation_merge": {
    "apply_coupling": true
  },
  "global_relation": {
    "min_segments": 2,
    "dynamic_predicates": ["toward", "away", "follow", "chase"],
    "vl_enabled": false,
    "vl_dry_run": false,
    "vl_model": "qwen-vl-max",
    "vl_sample_frames": 8,
    "vl_tile_h": 320
  },
  "relation_verify": {
    "low_confidence_threshold": 0.45,
    "strong_model_review_enabled": false,
    "strong_model": "qwen-vl-max",
    "strong_model_confidence_threshold": 0.35,
    "strong_model_dry_run": false,
    "strong_model_sample_frames": 6,
    "vl_tile_h": 320
  },
  "evaluate": {
    "enabled": true,
    "gold_json": "gold/relations_gold.json"
  }
}
