{
  "project": {
    "run_mode": "main",
    "schema_version": "1.3",
    "artifact_span_convention": "inclusive",
    "canonical_span_convention": "half_open",
    "prompt_version": "main-v7-batched-direction-schema"
  },
  "vocabulary": {
    "discovery_enabled": true,
    "discovery_model": "qwen3.7-plus"
  },
  "detector": {
    "sampling_mode": "adaptive_sparse",
    "detection_interval": 5,
    "min_detection_interval": 2,
    "scene_change_threshold": 0.2,
    "batch_size": 5,
    "temperature": 0.0,
    "top_p": 0.05,
    "top_k": 1
  },
  "tracking": {
    "algorithm": "sparse_ocsort",
    "max_age": 6,
    "min_hits": 2,
    "min_new_track_conf": 0.0,
    "class_aware": true,
    "max_interpolation_gap": 8
  },
  "relations": {
    "api_model": "qwen3.7-plus",
    "dry_run": false,
    "max_windows": 0,
    "max_pairs_per_window": 0,
    "max_frames_per_window": 8,
    "event_burst_size": 5,
    "batch_windows_per_call": 6,
    "candidate_limit": 14,
    "expanded_candidate_limit": 24,
    "allow_request_more_frames": true,
    "max_additional_frames": 4
  },
  "relation_verify": {
    "strong_model_review_enabled": true,
    "strong_model": "qwen-vl-max",
    "apply_actions": true,
    "apply_coupling": false,
    "category_constraints_enabled": false
  },
  "evaluate": {"enabled": false}
}
