{
  "project": {
    "run_mode": "main",
    "schema_version": "1.3",
    "artifact_span_convention": "inclusive",
    "canonical_span_convention": "half_open",
    "prompt_version": "main-v8-calibrated-composite-routing"
  },
  "vocabulary": {
    "discovery_enabled": false,
    "discovery_model": "kimi-k2.6"
  },
  "detector": {
    "detector_backend": "rexomni",
    "sampling_mode": "fixed_sparse",
    "detection_interval": 3,
    "min_detection_interval": 3,
    "scene_change_threshold": 0.2,
    "batch_size": 5,
    "temperature": 0.0,
    "top_p": 0.05,
    "top_k": 1
  },
  "tracking": {
    "algorithm": "sparse_ocsort",
    "max_age": 10,
    "min_hits": 2,
    "min_new_track_conf": 0.0,
    "class_aware": true,
    "max_interpolation_gap": 6
  },
  "relations": {
    "api_model": "kimi-k2.6",
    "dry_run": false,
    "max_windows": 1,
    "max_pairs_per_window": 1,
    "max_frames_per_window": 8,
    "event_burst_size": 5,
    "batch_windows_per_call": 1,
    "candidate_limit": 14,
    "expanded_candidate_limit": 24,
    "allow_request_more_frames": false,
    "max_additional_frames": 0,
    "retries": 0,
    "request_timeout_sec": 60
  },
  "relation_verify": {
    "strong_model_review_enabled": false,
    "strong_model": "kimi-k2.6",
    "apply_actions": false,
    "apply_coupling": false,
    "category_constraints_enabled": false
  },
  "evaluate": {"enabled": false}
}
